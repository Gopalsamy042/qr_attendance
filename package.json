{
  "name": "qr-attendance-system",
  "version": "1.0.0",
  "description": "QR code based attendance with rotating tokens to prevent proxy marking",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "ioredis": "^5.6.0",
    "json2csv": "^5.0.7",
    "prisma": "^6.4.1",
    "qrcode": "^1.5.4"
  }
}
