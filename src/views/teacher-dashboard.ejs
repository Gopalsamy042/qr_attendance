<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= session.className %> — live attendance</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Inter', sans-serif;
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
        color: white;
        min-height: 100vh;
      }
      .glass-panel {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .table-row-hover:hover {
        background: rgba(255, 255, 255, 0.1);
      }
    </style>
  </head>
  <body class="p-4 md:p-8">
    <main class="max-w-6xl mx-auto space-y-8">
      <header class="glass-panel rounded-2xl p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <p class="text-indigo-400 font-semibold tracking-wider text-sm uppercase mb-1">Live session</p>
          <h1 class="text-3xl font-bold mb-2 tracking-tight"><%= session.className %></h1>
          <div class="flex items-center gap-3 text-sm text-slate-400">
            <span>Status:</span>
            <span id="session-status" class="px-2 py-1 rounded-full text-xs font-semibold <%= session.status === 'ACTIVE' ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-red-500/20 text-red-400 border border-red-500/30' %>">
              <%= session.status %>
            </span>
            <span class="opacity-50">·</span>
            <span>QR rotates every <%= rotationSeconds %>s</span>
          </div>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto">
          <a class="flex-1 md:flex-none text-center px-4 py-2 border border-slate-600 hover:bg-slate-800 text-white font-medium rounded-lg transition-colors" href="/api/sessions/<%= session.id %>/export">
            Download CSV
          </a>
          <% if (session.status === 'ACTIVE') { %>
          <button id="end-session" class="flex-1 md:flex-none px-4 py-2 bg-red-500/80 hover:bg-red-500 text-white font-medium rounded-lg transition-colors border border-red-400/50" type="button">
            End Session
          </button>
          <% } %>
        </div>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- QR Panel -->
        <article class="lg:col-span-4 glass-panel rounded-2xl p-6 md:p-8 flex flex-col items-center text-center">
          <h2 class="text-xl font-bold mb-2">Project this QR</h2>
          <p class="text-slate-400 text-sm mb-6">Students open their camera app and scan. The URL expires with the token.</p>
          
          <div class="bg-white p-4 rounded-xl shadow-lg mb-6 relative w-full aspect-square max-w-[320px] flex items-center justify-center">
            <img id="qr-image" alt="Attendance QR code" class="w-full h-full object-contain" />
            <p id="qr-error" class="absolute inset-0 flex items-center justify-center bg-red-500/90 text-white font-medium rounded-xl hidden"></p>
          </div>
          
          <div class="bg-slate-800/50 rounded-lg px-4 py-3 w-full border border-slate-700/50">
            <p class="text-sm text-slate-300">
              Next refresh in <strong id="qr-countdown" class="text-indigo-400 font-mono text-lg ml-1">—</strong>s
            </p>
          </div>
        </article>

        <!-- List Panel -->
        <article class="lg:col-span-8 glass-panel rounded-2xl p-6 md:p-8 flex flex-col">
          <div class="flex justify-between items-end mb-6 pb-4 border-b border-slate-700/50">
            <h2 class="text-xl font-bold">Present Students</h2>
            <p class="text-slate-400 text-sm">
              <span id="present-count" class="font-bold text-indigo-400 text-lg"><%= attendance.count %></span> marked
            </p>
          </div>
          
          <div class="flex-1 overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-300">
              <thead class="text-xs text-slate-400 uppercase bg-slate-800/50 rounded-lg">
                <tr>
                  <th scope="col" class="px-4 py-3 rounded-l-lg">Roll Number</th>
                  <th scope="col" class="px-4 py-3">Name</th>
                  <th scope="col" class="px-4 py-3 rounded-r-lg">Marked At</th>
                </tr>
              </thead>
              <tbody id="attendance-body" class="divide-y divide-slate-700/50">
                <% attendance.students.forEach(function (s) { %>
                <tr class="table-row-hover transition-colors">
                  <td class="px-4 py-4 font-mono text-indigo-300"><%= s.rollNumber %></td>
                  <td class="px-4 py-4 font-medium text-white"><%= s.name %></td>
                  <td class="px-4 py-4 text-slate-400"><%= new Date(s.markedAt).toLocaleString() %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
            
            <% if (attendance.count === 0) { %>
            <div id="empty-note" class="text-center py-12">
              <p class="text-slate-500 italic">Waiting for the first scan…</p>
            </div>
            <% } %>
          </div>
        </article>
      </div>
    </main>
    <script>
      window.DASHBOARD = {
        sessionId: "<%= session.id %>",
        status: "<%= session.status %>",
      };
    </script>
    <script src="/public/js/dashboard.js"></script>
  </body>
</html>
