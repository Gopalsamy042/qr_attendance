# PostgreSQL connection string (Docker Compose defaults match these credentials)
DATABASE_URL="postgresql://attendance:attendance@localhost:5432/qr_attendance?schema=public"

# Redis connection string (Docker Compose exposes Redis on localhost:6379)
REDIS_URL="redis://localhost:6379"

# HTTP port the Express server listens on
PORT=3000

# Public origin encoded inside QR URLs — must be reachable from student phones.
# On a projector/demo LAN, use your machine IP, e.g. http://192.168.1.10:3000
BASE_URL="http://localhost:3000"

# How long a QR token is intended to stay on screen before rotation (seconds)
QR_ROTATION_SECONDS=20

# Redis TTL for the token. Slightly longer than rotation so a scan in flight
# still matches after the dashboard has already requested the next QR.
QR_TOKEN_TTL_SECONDS=25
